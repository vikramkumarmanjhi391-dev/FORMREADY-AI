<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="no_backup" />
        <exclude domain="file" path="document_locker" />
        <exclude domain="database" path="formready_locker.db" />
        <exclude domain="database" path="formready_locker.db-wal" />
        <exclude domain="database" path="formready_locker.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="no_backup" />
        <exclude domain="file" path="document_locker" />
        <exclude domain="database" path="formready_locker.db" />
        <exclude domain="database" path="formready_locker.db-wal" />
        <exclude domain="database" path="formready_locker.db-shm" />
    </device-transfer>
</data-extraction-rules>
